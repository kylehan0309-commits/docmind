DATABASE_URL=sqlite+aiosqlite:///./docmind.db
UPLOAD_DIR=./uploads

# Milestone 2: local RAG (all local, no API keys needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
RETRIEVAL_TOP_K=5

# Milestone 3: knowledge graph
EXTRACTION_MODEL=qwen2.5:7b
ENTITY_MERGE_THRESHOLD=0.87

# Figure understanding (used only when a PDF is uploaded with ?describe_figures=true)
VISION_MODEL=granite3.2-vision
VISION_DPI=150

# Optional cloud providers. Leave the keys blank to stay 100% local. When a key
# is set, that provider becomes selectable in the UI's Local / Claude / Gemini toggle.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_PROVIDER=local
SEED_DEMO=true
