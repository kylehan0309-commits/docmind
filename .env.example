# Copy this file to .env and fill in what you need:  cp .env.example .env
# Everything here has a working default except the cloud API keys.

# ---- LLM provider --------------------------------------------------------
# "local"     -> Ollama (needs `docker compose --profile local up`, or a host Ollama)
# "anthropic" -> Claude, needs ANTHROPIC_API_KEY
# "gemini"    -> Gemini, needs GEMINI_API_KEY (free tier is fine)
LLM_PROVIDER=local

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Google Gemini - https://aistudio.google.com/  (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- Ports ------------------------------------------------------------
# Web UI is served here ->  http://localhost:8080
WEB_PORT=8080

# ---- Local models (only when LLM_PROVIDER=local) ---------------------
# Default points at the compose "ollama" service. To use Ollama running on
# the host instead, set: OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
EXTRACTION_MODEL=qwen2.5:7b
VISION_MODEL=granite3.2-vision

# ---- Misc -----------------------------------------------------------
# Seed the "DocMind demo.pdf" document + knowledge graph on first start.
SEED_DEMO=true
